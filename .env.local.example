# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Only for server-side usage. Do NOT expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Google Analytics
# Get from Google Analytics: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API
NEXT_PUBLIC_BACKEND_URL=https://api.englishcorner.cyou:8443/chat

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_TABLE_NAME=forever-english-corner-dev
